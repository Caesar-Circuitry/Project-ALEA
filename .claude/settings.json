{
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run pyright*)",
      "Bash(uv run mkdocs build*)",
      "Bash(uv run pre-commit*)",
      "Bash(just *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python .claude/hooks/guard_physics.py"
          }
        ]
      }
    ]
  }
}
