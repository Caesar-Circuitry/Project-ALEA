{
  "name": "ALEA CPU",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "dev",
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "mounts": [
    "source=${localWorkspaceFolder}/.git/hooks,target=${localWorkspaceFolder}/.git/hooks,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/config,target=${localWorkspaceFolder}/.git/config,type=bind,readonly",
    "source=alea-dev-venv,target=/home/dev/.venv,type=volume",
    "source=alea-dev-uv-cache,target=/home/dev/.cache/uv,type=volume"
  ],
  "containerEnv": {
    "GIT_AUTHOR_NAME": "ALEA dev container",
    "GIT_AUTHOR_EMAIL": "alea-dev@users.noreply.invalid",
    "GIT_COMMITTER_NAME": "ALEA dev container",
    "GIT_COMMITTER_EMAIL": "alea-dev@users.noreply.invalid"
  },
  "runArgs": ["--cap-drop=ALL", "--security-opt=no-new-privileges", "--pids-limit=512"],
  "postCreateCommand": "just sync",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
